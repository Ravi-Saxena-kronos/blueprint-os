DEPLOY_TARGET=vercel

# Initial launch: set to 1 so intake skips Stripe and starts the job immediately
FREE_ACCESS_MODE=0

APP_URL=https://your-project.vercel.app
DOMAIN=your-project.vercel.app

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPRESS=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

ASSEMBLYAI_API_KEY=

# LLM — pick ONE free provider (no OpenAI credits needed), or OpenAI if you have billing
LLM_PROVIDER=groq
# Groq (see your models: GET https://api.groq.com/openai/v1/models)
# openai/gpt-oss-20b | openai/gpt-oss-120b | qwen/qwen3.8-27b
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Only used when LLM_PROVIDER=openai (ignored for Groq/Gemini)
OPENAI_MODEL=gpt-4o-mini

REVIEW_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
MODEL_BUDGET_CEILING_CENTS=20000

QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
# Set to 1 if QStash token/region fails (403) — blueprints run inline on the job status page
QSTASH_DISABLED=0
# Set to 1 if QStash token/region fails (403) — blueprints run inline on the job status page
QSTASH_DISABLED=0
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
INTERNAL_JOB_SECRET=change-me-long-random-string

BLOB_READ_WRITE_TOKEN=

# Local Docker only (optional)
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379
